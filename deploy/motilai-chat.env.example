# 安装位置：/etc/motilai-chat.env
# 修改后执行：sudo systemctl restart motilai-chat
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
MOTILAI_DATA_DIR=/home/ubuntu/softwares/motilai/.data
POSTGRES_DB=motilai
POSTGRES_USER=motilai
POSTGRES_PASSWORD=change-this-password
MOTILAI_ENV_FILE=/etc/motilai-chat.env
